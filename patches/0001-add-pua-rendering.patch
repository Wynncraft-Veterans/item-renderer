index 0000000..f5b6ac2
--- /dev/null
+++ b/app/lib/wynntils/rolled-to-card.ts
@@ -0,0 +1,179 @@
+/**
+ * Adapter: turn a PUA-decoded item (parseIdString blocks) plus the matched
+ * base SearchItem into the structured `ItemMeta` props that
+ * `app/components/OgImage/ItemCard.takumi.vue` already accepts.
+ *
+ * The strategy is to reuse `extractItemMeta(baseItem)` for everything the
+ * base item carries (tier, icon, lore, defence, dps, sp, ...), then swap
+ * the rolled values + roll-percent colors from the decoded identifications
+ * into its `idRows`. Powders, shiny, reroll count are not surfaced today —
+ * `ItemCard.takumi.vue`'s `powderSlots` is the slot count (which is a
+ * base-item property), not the filled count.
+ *
+ * What an identification entry's `value` holds depends on the block's
+ * layout (Arethusa spec §4,
+ * https://gist.github.com/wenweia/83721cfeeafb92d0cb85466bde7e8738):
+ *   - `v3` (version byte 0x02, Wynntils v4.2.9+): the number the tooltip
+ *     shows.
+ *   - `legacy` (0x00/0x01): Wynncraft's internal roll (30–130), from which
+ *     the shown number is rebuilt.
+ * In both, the eight spell-cost stats travel with the opposite sign.
+ */
+
+import type { Block, IdentificationDataBlock } from './decode'
+import type { ItemMeta, IdRow } from '~/lib/items/item-meta'
+import type { IdRange, SearchItem } from '~/lib/items-search/types'
+import { humanizeField, isInverted } from '~/lib/data/identifications'
+import { extractItemMeta } from '~/lib/items/item-meta'
+import { ID_BAD_COLOR, ID_GOOD_COLOR, idIsGood } from '~/lib/items/tooltip'
+import { rollPercent } from './roll-percent'
+
+// Wynncraft / Minecraft chat-colour palette for roll-percent tiers.
+// Mirrors roll-percent.ts's CSS-var ladder (red / gold / yellow / green /
+// aqua) — Takumi can't resolve CSS vars, so we inline hex.
+const ROLL_RED = '#FF5555'
+const ROLL_GOLD = '#FFAA00'
+const ROLL_YELLOW = '#FFFF55'
+const ROLL_GREEN = '#55FF55'
+const ROLL_AQUA = '#55FFFF'
+
+// `1stSpellCost`–`4thSpellCost` and `raw1stSpellCost`–`raw4thSpellCost`.
+// Arethusa writes their value and base with the opposite sign to the item
+// data and the tooltip: a −5 cost travels as 5.
+const SPELL_COST = /^(?:raw)?[1-4](?:st|nd|rd|th)SpellCost$/
+
+// Wynncraft's roll meter runs from 0x00 (empty) to 0x23 (full).
+const METER_FULL = 0x23
+
+type IdentEntry = IdentificationDataBlock['identifications'][number]
+
+function rollPctToHex(pct: number | null, isGood: boolean): string {
+  if (pct == null)
+    return isGood ? ID_GOOD_COLOR : ID_BAD_COLOR
+  if (pct < 20)
+    return ROLL_RED
+  if (pct < 50)
+    return ROLL_GOLD
+  if (pct < 80)
+    return ROLL_YELLOW
+  if (pct < 100)
+    return ROLL_GREEN
+  return ROLL_AQUA
+}
+
+function findIdentBlock(blocks: Block[]) {
+  for (const b of blocks) {
+    if (b.name === 'IdentificationData')
+      return b
+  }
+  return null
+}
+
+/**
+ * The number the tooltip shows for one rolled entry, or null when it can't
+ * be known.
+ *
+ * Legacy entries carry the internal roll: shown = base × roll ÷ 100,
+ * rounded, where 0 becomes ±1 with the base's sign. `Math.round` already is
+ * the spec's rounding (half away from zero for a positive base, half toward
+ * zero for a negative one), and applying it to the spell-cost base as the
+ * item data has it equals the spec's flip-the-base-and-swap-the-rules.
+ */
+function shownValue(
+  ent: IdentEntry,
+  layout: IdentificationDataBlock['layout'],
+  key: string,
+  range: IdRange | undefined,
+): number | null {
+  if (ent.value == null)
+    return null
+  const spellCost = SPELL_COST.test(key)
+  if (layout === 'v3')
+    return spellCost ? -ent.value : ent.value
+  // Extended mode carries the base as of sharing; normal mode leaves it to
+  // the item data.
+  const base = ent.base != null ? (spellCost ? -ent.base : ent.base) : range?.raw
+  if (base == null)
+    return null
+  return Math.round((base * ent.value) / 100) || Math.sign(base)
+}
+
+function rolledRow(key: string, shown: number, range: IdRange | undefined, meter: number | undefined): IdRow {
+  const { label, unit } = humanizeField(key)
+  const inverted = isInverted(key)
+
+  let pct: number | null = null
+  let estimated = false
+  const inRange = range != null
+    && shown >= Math.min(range.min, range.max)
+    && shown <= Math.max(range.min, range.max)
+  if (inRange) {
+    pct = rollPercent(shown, range, inverted)
+  }
+  else if (meter != null) {
+    // The value is outside the range the item data knows (the item was
+    // rebalanced, or is newer than the data). The spec's answer is the
+    // roll meter Wynncraft drew on the sharer's tooltip.
+    pct = (meter / METER_FULL) * 100
+    estimated = true
+  }
+
+  const sign = shown > 0 ? '+' : ''
+  const pctText = pct == null ? '' : ` [${estimated ? '~' : ''}${pct.toFixed(1)}%]`
+  return {
+    label,
+    left: '',
+    right: `${sign}${shown}${unit}${pctText}`,
+    color: rollPctToHex(pct, idIsGood(shown, inverted)),
+  }
+}
+
+/**
+ * Combine base-item display data with rolled identifications.
+ *
+ * @param baseItem  The SearchItem matched against the decoded NameData.
+ * @param blocks    The full Block[] from parseIdString.
+ * @param idKeys    Stat-id-byte → v3 API name map (from getIdKeys()).
+ */
+export function extractRolledMeta(
+  baseItem: SearchItem,
+  blocks: Block[],
+  idKeys: Map<number, string>,
+): ItemMeta {
+  const baseMeta = extractItemMeta(baseItem)
+
+  const identBlock = findIdentBlock(blocks)
+  if (!identBlock)
+    return baseMeta
+
+  const rolled = new Map<string, IdRow>()
+  for (const ent of identBlock.identifications) {
+    // Pre-identified entries (extended mode only) are fixed stats, which
+    // the base item's own rows already show.
+    if (ent.preid)
+      continue
+    const key = idKeys.get(ent.kind)
+    if (!key)
+      continue
+    const range = baseItem.identifications[key]
+    const shown = shownValue(ent, identBlock.layout, key, range)
+    if (shown == null)
+      continue
+    rolled.set(key, rolledRow(key, shown, range, ent.meter))
+  }
+
+  // Keep the base item's rows, order and fixed stats, with each rolled
+  // value swapped in. `extractItemMeta` builds `idRows` by mapping
+  // `Object.entries(item.identifications)` one-to-one, so row i is key i.
+  // A rolled stat the item data doesn't have goes last.
+  const keys = Object.keys(baseItem.identifications)
+  const idRows = keys
+    .map((key, i) => rolled.get(key) ?? baseMeta.idRows[i])
+    .filter((row): row is IdRow => row != null)
+  for (const [key, row] of rolled) {
+    if (!(key in baseItem.identifications))
+      idRows.push(row)
+  }
+
+  return { ...baseMeta, idRows }
+}
