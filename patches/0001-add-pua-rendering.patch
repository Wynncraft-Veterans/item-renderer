--- /dev/null
+++ b/app/lib/wynntils/pua-item.ts
@@ -0,0 +1,113 @@
+/**
+ * Item lookup for the PUA route: find the base item an Arethusa item string
+ * names, in wynn.tools' item data.
+ *
+ * Kept out of the route so it has no Nitro globals, which lets the image
+ * build type-check it against upstream.
+ */
+
+import type { Block, TypeDataBlock } from './decode'
+import type { VersionEntry } from '~/lib/data/cdn-adapter/version-paths'
+import type { SearchItem } from '~/lib/items-search/types'
+import { latestVersionId, resolveVersionSegment } from '~/lib/data/cdn-adapter/version-paths'
+import { createCdnClient } from '~/lib/data/cdn-client'
+import { loadSearchData } from '~/lib/items-search/load-search-data'
+import { buildSlugIndex, resolveSlug, slugify } from '~/lib/items-search/slug'
+
+// Item data only changes with a game update, but the sidecar runs for weeks
+// between image rebuilds. At most this often, check the CDN's version index
+// and reload when it names a newer snapshot; serve the current data meanwhile.
+const VERSION_CHECK_INTERVAL_MS = 60 * 60 * 1000
+
+let itemCache: { gameVersion: string, index: Map<string, SearchItem[]>, checkedAt: number } | null = null
+let loading: Promise<void> | null = null
+let refreshing: Promise<void> | null = null
+
+// A fresh CDN client per load: the client caches every snapshot file it
+// fetches for its whole lifetime, so a long-lived one would keep each
+// superseded snapshot in memory.
+async function loadItems(cdnBaseUrl: string): Promise<void> {
+  const data = await loadSearchData(createCdnClient(cdnBaseUrl))
+  itemCache = { gameVersion: data.gameVersion, index: buildSlugIndex(data.items), checkedAt: Date.now() }
+}
+
+async function reloadIfNewer(cdnBaseUrl: string, current: NonNullable<typeof itemCache>): Promise<void> {
+  // Stamped first, so an unreachable CDN is retried next interval rather
+  // than on every request.
+  current.checkedAt = Date.now()
+  const versions = await createCdnClient(cdnBaseUrl).fetchJson<VersionEntry[]>('versions.json')
+  if (resolveVersionSegment(latestVersionId(versions), versions) !== current.gameVersion)
+    await loadItems(cdnBaseUrl)
+}
+
+/**
+ * The slug index of the item data, loading or refreshing it as needed.
+ * `server/plugins/pua-warmup.ts` calls this at startup, so requests
+ * normally find it loaded.
+ */
+export async function getItemIndex(cdnBaseUrl: string): Promise<Map<string, SearchItem[]>> {
+  if (!itemCache) {
+    // One load, however many requests arrive while it runs: otherwise a
+    // burst would fetch and parse the whole item data once per request,
+    // under a 256 MB memory cap.
+    loading ??= loadItems(cdnBaseUrl).finally(() => {
+      loading = null
+    })
+    await loading
+  }
+  else if (!refreshing && Date.now() - itemCache.checkedAt > VERSION_CHECK_INTERVAL_MS) {
+    refreshing = reloadIfNewer(cdnBaseUrl, itemCache)
+      .catch(err => console.warn(`[pua] item data refresh failed: ${(err as Error).message}`))
+      .finally(() => {
+        refreshing = null
+      })
+  }
+  return itemCache!.index
+}
+
+// Ascended mythics: Wynntils v4.2.15+ shares them as `Ascended <name>`,
+// older versions as `Masterwork <name>`, and the item data (from the
+// Wynncraft API) files them under `Masterwork <name>` for now. Try the name
+// as written, then with the other prefix, so both kinds of share resolve
+// whichever name the data uses. Only a mythic may match that way: normal
+// weapons such as `Masterwork Maple Bow` share the prefix but are never
+// ascended.
+const ASCENSION_PREFIX = /^(Ascended|Masterwork) (.+)$/
+
+/** The base item a gear, tome or charm's Name block names, if any. */
+export function findItem(index: Map<string, SearchItem[]>, name: string): SearchItem | undefined {
+  const direct = resolveSlug(index, slugify(name))
+  if (direct)
+    return direct
+  const match = ASCENSION_PREFIX.exec(name)
+  if (!match)
+    return undefined
+  const other = match[1] === 'Ascended' ? 'Masterwork' : 'Ascended'
+  const swapped = resolveSlug(index, slugify(`${other} ${match[2]}`))
+  return swapped?.tier.toLowerCase() === 'mythic' ? swapped : undefined
+}
+
+// Crafted gear (0x03), crafted consumables (0x04) and mounts (0x05) travel
+// with their name as plain chat text after the string, and decoders must
+// ignore any Name block in them: it never passed Wynncraft's chat filter
+// (Arethusa spec, Name block notes and "Sharing in Chat"). These items get
+// the generic name the spec prescribes instead.
+const CRAFTED_GEAR_TYPES = ['Spear', 'Wand', 'Dagger', 'Bow', 'Relik', 'Ring', 'Bracelet', 'Necklace', 'Helmet', 'Chestplate', 'Leggings', 'Boots', 'Weapon', 'Accessory']
+const CRAFTED_CONSUMABLE_TYPES = ['Potion', 'Food', 'Scroll', 'Consumable']
+const MOUNT_TYPES = ['Horse', 'Wyvern', 'Adasaur']
+
+/** The generic name for a crafted item or mount, or null for any other item. */
+export function genericName(blocks: Block[]): string | null {
+  const itemType = blocks.find((b): b is TypeDataBlock => b.name === 'TypeData')?.itemType
+  if (itemType !== 3 && itemType !== 4 && itemType !== 5)
+    return null
+  for (const b of blocks) {
+    if (b.name === 'CustomGearType')
+      return `Crafted ${CRAFTED_GEAR_TYPES[b.gearType] ?? 'Gear'}`
+    if (b.name === 'CustomConsumableTypeData')
+      return `Crafted ${CRAFTED_CONSUMABLE_TYPES[b.consumableType] ?? 'Consumable'}`
+    if (b.name === 'MountTypeData')
+      return MOUNT_TYPES[b.mountType] ?? 'Mount'
+  }
+  return itemType === 5 ? 'Mount' : 'Crafted Item'
+}
diff --git a/app/lib/wynntils/rolled-to-card.ts b/app/lib/wynntils/rolled-to-card.ts
