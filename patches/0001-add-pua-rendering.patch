+++ b/server/api/_og/pua/[encoded].get.ts
@@ -0,0 +1,63 @@
+/**
+ * PUA-encoded item OG image route.
+ *
+ * Mirrors `server/api/_og/item/[slug].get.ts` but takes a PUA-encoded
+ * item string (Wynntils' private-use-area item-share format) instead of
+ * a base-item slug. Renders the same `ItemCard` OG component with the
+ * rolled identification values from the decoded item.
+ *
+ * Used by the Wynncraft Veterans "nazbot" Discord bridge to attach an
+ * item-card image when a guild chat message contains a PUA-encoded item.
+ * Any 404 carries an `Unknown item: <name>` reason the bridge shows in its
+ * text fallback.
+ */
+
+import { Buffer } from 'node:buffer'
+import { slugify } from '~/lib/items-search/slug'
+import { findItem, genericName, getItemIndex } from '~/lib/wynntils/pua-item'
+import { parseIdString } from '~/lib/wynntils/decode'
+import { getIdKeys } from '~/lib/wynntils/id-keys'
+import { extractRolledMeta } from '~/lib/wynntils/rolled-to-card'
+
+export default defineEventHandler(async (event) => {
+  const encoded = getRouterParam(event, 'encoded')
+  if (!encoded)
+    throw createError({ statusCode: 400, statusMessage: 'Missing encoded parameter' })
+
+  let blocks
+  try {
+    blocks = parseIdString(encoded)
+  }
+  catch (err) {
+    throw createError({ statusCode: 400, statusMessage: `Decode failed: ${(err as Error).message}` })
+  }
+
+  // Crafted items and mounts aren't in the item data, and their Name block
+  // must be ignored.
+  const generic = genericName(blocks)
+  if (generic)
+    throw createError({ statusCode: 404, statusMessage: `Unknown item: ${generic}` })
+
+  let nameStr: string | null = null
+  for (const b of blocks) {
+    if (b.name === 'NameData') {
+      nameStr = b.nameStr
+      break
+    }
+  }
+  if (!nameStr)
+    throw createError({ statusCode: 422, statusMessage: 'No NameData block in encoded item' })
+
+  const index = await getItemIndex(useRuntimeConfig().public.cdnBaseUrl)
+  const baseItem = findItem(index, nameStr)
+  if (!baseItem)
+    throw createError({ statusCode: 404, statusMessage: `Unknown item: ${nameStr}` })
+
+  const idKeys = await getIdKeys()
+  const itemMeta = extractRolledMeta(baseItem, blocks, idKeys)
+  const ogPath = buildOgImagePath('ItemCard', itemMeta as unknown as Record<string, unknown>, `/items/${slugify(nameStr)}`)
+  const data = await $fetch<ArrayBuffer>(ogPath, { responseType: 'arrayBuffer' })
+
+  setResponseHeader(event, 'content-type', 'image/png')
+  return Buffer.from(data)
+})
diff --git a/server/plugins/pua-warmup.ts b/server/plugins/pua-warmup.ts
new file mode 100644
index 0000000..0d5b285
--- /dev/null
+++ b/server/plugins/pua-warmup.ts
@@ -0,0 +1,15 @@
+/**
+ * Load the PUA route's item data and stat ids when the server starts
+ * rather than on the first render. The load takes seconds, about as long
+ * as the Discord bridge waits for a card, so done lazily it made the
+ * first shares after every restart fall back.
+ */
+
+import { getIdKeys } from '~/lib/wynntils/id-keys'
+import { getItemIndex } from '~/lib/wynntils/pua-item'
+
+export default defineNitroPlugin(() => {
+  const { cdnBaseUrl } = useRuntimeConfig().public
+  Promise.all([getItemIndex(cdnBaseUrl), getIdKeys()])
+    .catch(err => console.warn(`[pua] warm-up failed; the first render will retry: ${(err as Error).message}`))
+})
